# Copy to .env and fill in. Never commit the real .env.

# AI backend: stub | openai | anthropic
COBOTICS_AI_BACKEND=stub

# Model name (used by openai/anthropic backends)
COBOTICS_AI_MODEL=gpt-4o-mini

# API keys (only needed for the matching backend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hardware backend: simulator | real
COBOTICS_HARDWARE_BACKEND=simulator

# Logging level: DEBUG | INFO | WARNING | ERROR
COBOTICS_LOG_LEVEL=INFO
