# Copy to .env and fill in. Never commit the real .env.

# AI backend: stub | openai | anthropic | nebius
#   stub   - offline, deterministic, no key required (default)
#   nebius - Nebius Token Factory, serving an NVIDIA Nemotron model
COBOTICS_AI_BACKEND=stub

# Model name.
#   openai/anthropic: a model id for that provider
#   nebius: an NVIDIA Nemotron model id, e.g. nvidia/Llama-3_3-Nemotron-Super-49B-v1
COBOTICS_AI_MODEL=gpt-4o-mini

# Nebius Token Factory (OpenAI-compatible inference API)
COBOTICS_NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/

# API keys (only needed for the matching backend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEBIUS_API_KEY=

# Hardware backend: simulator | real
COBOTICS_HARDWARE_BACKEND=simulator

# Logging level: DEBUG | INFO | WARNING | ERROR
COBOTICS_LOG_LEVEL=INFO
